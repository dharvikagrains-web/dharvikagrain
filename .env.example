# ------------------------------------------------------------------------------
# DHARVIKA GRAINS — Environment Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit real credentials or secrets to version control.
# ------------------------------------------------------------------------------

# Database Connection (PostgreSQL / Supabase / Neon / Local)
# When unset, system operates with the high-performance built-in memory/file store
DATABASE_URL=

# Cryptographic Authentication Secret (used for HMAC session cookies)
# Generate with: openssl rand -base64 32
AUTH_SECRET=dharvika_grain_luxury_auth_secret_dev_key_2026_harvest

# Administrative & Development Testing Identities
ADMIN_EMAIL=dharvikagrains@gmail.com
TEST_CUSTOMER_EMAIL=pavangeesala81@gmail.com

# Indian Payment Gateway — Razorpay
# Obtain from Razorpay Dashboard (Settings -> API Keys & Webhooks)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# Indian Logistics & Shipping Provider Integrations
# Delhivery / Blue Dart / Shiprocket credentials
SHIPPING_PROVIDER=standard
SHIPPING_PROVIDER_API_KEY=
SHIPPING_PROVIDER_SECRET=

# Transactional Email Notification Service (Resend / SendGrid / Postmark)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=orders@dharvikagrains.in
ADMIN_NOTIFICATION_EMAIL=dharvikagrains@gmail.com

# Public App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
