// =============================================================================
// DHARVIKA GRAINS — PostgreSQL Relational Database Schema (Prisma ORM)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// 1. Identity & Customer Profiles
// Note: User credentials and sessions are managed by Supabase Auth (auth.users).
// Profiles are linked to auth.users via id (UUID).
// -----------------------------------------------------------------------------
model Profile {
  id        String   @id @db.Uuid
  fullName  String?  @map("full_name")
  email     String?
  phone     String?
  avatarUrl String?  @map("avatar_url")
  role      String   @default("CUSTOMER")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([role])
  @@index([email])
  @@map("profiles")
}

model SavedAddress {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  userEmail  String   @map("user_email")
  type       String   @default("Home")
  isDefault  Boolean  @default(false) @map("is_default")
  fullName   String   @map("full_name")
  mobile     String
  pincode    String
  houseFlat  String   @map("house_flat")
  streetArea String   @map("street_area")
  landmark   String?
  city       String   @default("Hyderabad")
  state      String   @default("Telangana")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userEmail])
  @@index([userId])
  @@map("saved_addresses")
}

// -----------------------------------------------------------------------------
// 2. Product Catalog
// Reconciled with rich attributes from migration 20261028000005
// -----------------------------------------------------------------------------
model Product {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  category            String
  description         String
  images              String[] @default([])
  price               Decimal  @db.Decimal(10, 2)
  comparePrice        Decimal? @map("compare_price") @db.Decimal(10, 2)
  weight              Decimal  @default(500) @db.Decimal(10, 2)
  unit                String   @default("g")
  isAvailable         Boolean  @default(true) @map("is_available")
  status              String   @default("PUBLISHED")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  localName           String?  @default("") @map("local_name")
  tagline             String?  @default("")
  shortDescription    String?  @default("") @map("short_description")
  weights             Json     @default("[]")
  ingredients         String[] @default([])
  originDetails       String?  @default("") @map("origin_details")
  processingDetails   String?  @default("") @map("processing_details")
  cookingInstructions String[] @default([]) @map("cooking_instructions")
  culinaryUses        String[] @default([]) @map("culinary_uses")
  storageInstructions String?  @default("") @map("storage_instructions")
  nutritionFacts      Json?    @default("{}") @map("nutrition_facts")
  badges              String[] @default([])
  batchInfo           Json?    @default("{}") @map("batch_info")
  labTestDetails      String?  @default("") @map("lab_test_details")
  isBestseller        Boolean  @default(false) @map("is_bestseller")
  isFeatured          Boolean  @default(false) @map("is_featured")
  rating              Decimal? @db.Decimal(3, 2)
  reviewCount         Int      @default(0) @map("review_count")

  @@index([category])
  @@index([status])
  @@index([slug])
  @@index([price])
  @@index([isBestseller])
  @@index([isFeatured])
  @@map("products")
}

// -----------------------------------------------------------------------------
// 3. Batches, Traceability & Traceable Inventory
// -----------------------------------------------------------------------------
model BatchEntity {
  id                  String            @id @default(uuid()) @db.Uuid
  batchNumber         String            @unique @map("batch_number")
  productId           String            @map("product_id")
  productName         String            @map("product_name")
  cropName            String?           @map("crop_name")
  manufacturingDate   DateTime          @map("manufacturing_date") @db.Date
  expiryDate          DateTime          @map("expiry_date") @db.Date
  totalQuantityKg     Decimal           @default(0) @map("total_quantity_kg") @db.Decimal(10, 2)
  remainingQuantityKg Decimal           @default(0) @map("remaining_quantity_kg") @db.Decimal(10, 2)
  sourceRegion        String?           @map("source_region")
  farmerCluster       String?           @map("farmer_cluster")
  qualityPassed       Boolean           @default(true) @map("quality_passed")
  status              String            @default("ACTIVE")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  inventory           InventoryEntity[]

  @@index([batchNumber])
  @@index([productId])
  @@index([status])
  @@map("batches")
}

model InventoryEntity {
  id            String       @id @default(uuid()) @db.Uuid
  sku           String       @unique
  productId     String       @map("product_id")
  productName   String       @map("product_name")
  variant       String
  batchNumber   String?      @map("batch_number")
  batch         BatchEntity? @relation(fields: [batchNumber], references: [batchNumber], onDelete: SetNull)
  stockReceived Int          @default(0) @map("stock_received")
  stockReserved Int          @default(0) @map("stock_reserved")
  stockSold     Int          @default(0) @map("stock_sold")
  stockAdjusted Int          @default(0) @map("stock_adjusted")
  stockReturned Int          @default(0) @map("stock_returned")
  stock         Int          @default(0)
  threshold     Int          @default(15)
  status        String       @default("In Stock")
  sellingPrice  Decimal      @map("selling_price") @db.Decimal(10, 2)
  mrp           Decimal      @db.Decimal(10, 2)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([sku])
  @@index([productId])
  @@index([batchNumber])
  @@map("inventory")
}

model InventoryTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String
  batchNumber String?  @map("batch_number")
  type        String
  quantity    Int
  stockBefore Int      @map("stock_before")
  stockAfter  Int      @map("stock_after")
  referenceId String?  @map("reference_id")
  notes       String?
  actorEmail  String   @map("actor_email")
  actorRole   String   @map("actor_role")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sku])
  @@index([referenceId])
  @@index([batchNumber])
  @@map("inventory_transactions")
}

// -----------------------------------------------------------------------------
// 4. Customer Cart & Line Items
// -----------------------------------------------------------------------------
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  items     CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id             String   @id @default(uuid()) @db.Uuid
  cartId         String   @map("cart_id") @db.Uuid
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId      String   @map("product_id")
  selectedWeight String   @default("500g") @map("selected_weight")
  quantity       Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([cartId, productId, selectedWeight])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// -----------------------------------------------------------------------------
// 5. Orders & Line Item Snapshots
// -----------------------------------------------------------------------------
model OrderEntity {
  id                      String                @id @default(uuid()) @db.Uuid
  orderNumber             String                @unique @default(dbgenerated("generate_order_number()")) @map("order_number")
  customerId              String?               @map("customer_id") @db.Uuid
  customerName            String                @map("customer_name")
  email                   String
  mobile                  String
  shippingAddressSnapshot Json                  @map("shipping_address_snapshot")
  billingAddressSnapshot  Json                  @map("billing_address_snapshot")
  subtotal                Decimal               @db.Decimal(10, 2)
  discount                Decimal               @default(0) @db.Decimal(10, 2)
  shippingFee             Decimal               @default(0) @map("shipping_fee") @db.Decimal(10, 2)
  tax                     Decimal               @default(0) @db.Decimal(10, 2)
  total                   Decimal               @db.Decimal(10, 2)
  currency                String                @default("INR")
  paymentStatus           String                @default("PENDING") @map("payment_status")
  orderStatus             String                @default("PENDING_PAYMENT") @map("order_status")
  paymentMethod           String                @default("RAZORPAY") @map("payment_method")
  couponCode              String?               @map("coupon_code")
  paymentId               String?               @map("payment_id")
  razorpayOrderId         String?               @map("razorpay_order_id")
  razorpayPaymentId       String?               @map("razorpay_payment_id")
  shipmentId              String?               @map("shipment_id")
  courierPartner          String?               @map("courier_partner")
  trackingId              String?               @map("tracking_id")
  awbNumber               String?               @map("awb_number")
  estimatedDelivery       String?               @map("estimated_delivery")
  timeline                Json                  @default("[]")
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  items                   OrderItem[]
  payments                PaymentEntity[]
  returnRequests          ReturnRequestEntity[]

  @@index([orderNumber])
  @@index([email])
  @@index([mobile])
  @@index([orderStatus])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id             String      @id @default(uuid()) @db.Uuid
  orderId        String      @map("order_id") @db.Uuid
  order          OrderEntity @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNumber    String      @map("order_number")
  productId      String      @map("product_id")
  slug           String      @default("")
  sku            String
  name           String
  localName      String      @default("") @map("local_name")
  category       String      @default("")
  description    String      @default("")
  selectedWeight String      @map("selected_weight")
  price          Decimal     @db.Decimal(10, 2)
  mrp            Decimal     @db.Decimal(10, 2)
  quantity       Int
  image          String
  batchNumber    String?     @map("batch_number")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([sku])
  @@index([orderNumber])
  @@map("order_items")
}

// -----------------------------------------------------------------------------
// 6. Payments & Webhooks
// -----------------------------------------------------------------------------
model PaymentEntity {
  id                String      @id @default(uuid()) @db.Uuid
  orderId           String      @map("order_id") @db.Uuid
  order             OrderEntity @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNumber       String      @map("order_number")
  amount            Int         // In paise
  currency          String      @default("INR")
  provider          String      @default("RAZORPAY")
  razorpayOrderId   String?     @map("razorpay_order_id")
  razorpayPaymentId String?     @map("razorpay_payment_id")
  signature         String?
  status            String      @default("CREATED")
  method            String?
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([orderNumber])
  @@index([razorpayOrderId])
  @@index([orderId])
  @@map("payments")
}

model PaymentEvent {
  id                String   @id @default(uuid()) @db.Uuid
  paymentId         String?  @map("payment_id")
  orderNumber       String   @map("order_number")
  eventType         String   @map("event_type")
  eventPayload      Json     @map("event_payload")
  signatureVerified Boolean  @default(false) @map("signature_verified")
  receivedAt        DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([orderNumber])
  @@index([eventType])
  @@map("payment_events")
}

// -----------------------------------------------------------------------------
// 7. Coupons & Usage Records
// -----------------------------------------------------------------------------
model CouponEntity {
  code            String              @id
  type            String              @default("PERCENTAGE")
  discountPercent Decimal?            @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal?            @map("discount_amount") @db.Decimal(10, 2)
  minOrderValue   Decimal             @default(0) @map("min_order_value") @db.Decimal(10, 2)
  maxDiscount     Decimal?            @map("max_discount") @db.Decimal(10, 2)
  description     String
  expiryDate      DateTime            @map("expiry_date") @db.Date
  usageLimit      Int                 @default(500) @map("usage_limit")
  timesUsed       Int                 @default(0) @map("times_used")
  perUserLimit    Int                 @default(1) @map("per_user_limit")
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  usageRecords    CouponUsageRecord[]

  @@index([isActive])
  @@index([expiryDate])
  @@map("coupons")
}

model CouponUsageRecord {
  id              String       @id @default(uuid()) @db.Uuid
  couponCode      String       @map("coupon_code")
  coupon          CouponEntity @relation(fields: [couponCode], references: [code], onDelete: Cascade)
  customerEmail   String       @map("customer_email")
  orderNumber     String       @map("order_number")
  discountApplied Decimal      @map("discount_applied") @db.Decimal(10, 2)
  usedAt          DateTime     @default(now()) @map("used_at") @db.Timestamptz(6)

  @@index([couponCode])
  @@index([customerEmail])
  @@index([orderNumber])
  @@map("coupon_usage_records")
}

// -----------------------------------------------------------------------------
// 8. Reviews & Returns
// -----------------------------------------------------------------------------
model ReviewEntity {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @map("product_id")
  productName      String   @map("product_name")
  customerId       String?  @map("customer_id") @db.Uuid
  customerName     String   @map("customer_name")
  customerEmail    String   @map("customer_email")
  rating           Int
  comment          String
  verifiedPurchase Boolean  @default(false) @map("verified_purchase")
  status           String   @default("PENDING")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId])
  @@index([customerEmail])
  @@index([status])
  @@map("reviews")
}

model ReturnRequestEntity {
  id            String       @id @default(uuid()) @db.Uuid
  orderId       String?      @map("order_id") @db.Uuid
  order         OrderEntity? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNumber   String       @map("order_number")
  customerName  String       @map("customer_name")
  customerEmail String       @map("customer_email")
  productName   String       @map("product_name")
  reason        String
  status        String       @default("REQUESTED")
  refundAmount  Decimal      @map("refund_amount") @db.Decimal(10, 2)
  refundMethod  String       @map("refund_method")
  requestedAt   DateTime     @default(now()) @map("requested_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([orderNumber])
  @@index([customerEmail])
  @@index([status])
  @@map("return_requests")
}

// -----------------------------------------------------------------------------
// 9. Append-Only Audit Trail
// -----------------------------------------------------------------------------
model AuditLogEntity {
  id         String   @id @default(uuid()) @db.Uuid
  actorEmail String   @map("actor_email")
  actorRole  String   @map("actor_role")
  action     String
  entity     String
  entityId   String   @map("entity_id")
  details    String
  timestamp  DateTime @default(now()) @db.Timestamptz(6)

  @@index([entity])
  @@index([entityId])
  @@index([actorEmail])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// 10. Secure Cryptographic OTP Verification Records
// -----------------------------------------------------------------------------
model OtpVerification {
  id              String   @id @default(uuid()) @db.Uuid
  identifier      String   @unique
  hashedCode      String   @map("hashed_code")
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)
  attempts        Int      @default(0)
  maxAttempts     Int      @default(5) @map("max_attempts")
  lastRequestedAt DateTime @default(now()) @map("last_requested_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("otp_verifications")
}
