// =============================================================================
// DHARVIKA GRAINS — PostgreSQL Relational Database Schema (Prisma ORM)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  SUPER_ADMIN
  ADMIN
  OPERATIONS
  INVENTORY_MANAGER
  CUSTOMER_SUPPORT
  CUSTOMER
  INVESTOR
}

enum InventoryTxType {
  STOCK_RECEIVED
  STOCK_RESERVED
  STOCK_SOLD
  STOCK_ADJUSTED
  STOCK_RETURNED
  STOCK_RELEASED
  PURCHASE
  RESERVATION
  RELEASE
  ADJUSTMENT
  RETURN
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  PAID
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

// -----------------------------------------------------------------------------
// 1. Identity & Customer Profiles
// -----------------------------------------------------------------------------
model User {
  id          String           @id @default(uuid())
  fullName    String
  email       String           @unique
  mobile      String
  role        UserRole         @default(CUSTOMER)
  isVerified  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  profile     CustomerProfile?
  addresses   SavedAddress[]
  orders      OrderEntity[]

  @@index([email])
  @@index([mobile])
}

model CustomerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String
  email            String
  mobile           String
  defaultAddressId String?
  createdAt        DateTime @default(now())
}

model Profile {
  id        String   @id @db.Uuid
  fullName  String?  @map("full_name")
  email     String?
  phone     String?
  avatarUrl String?  @map("avatar_url")
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([role])
  @@index([email])
  @@map("profiles")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  category     String
  description  String
  images       String[]
  price        Float
  comparePrice Float?   @map("compare_price")
  weight       Float    @default(500)
  unit         String   @default("g")
  isAvailable  Boolean  @default(true) @map("is_available")
  status       String   @default("PUBLISHED")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category])
  @@index([status])
  @@index([slug])
  @@map("products")
}

model SavedAddress {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail  String
  type       String   @default("Home")
  fullName   String
  mobile     String
  pincode    String
  houseFlat  String
  streetArea String
  landmark   String?
  city       String
  state      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userEmail])
}

// -----------------------------------------------------------------------------
// 2. Inventory & Batch Traceability
// -----------------------------------------------------------------------------
model InventoryEntity {
  id            String   @id @default(uuid())
  sku           String   @unique
  productId     String
  productName   String
  variant       String
  stockReceived Int      @default(0) @map("stock_received")
  stockReserved Int      @default(0) @map("stock_reserved")
  stockSold     Int      @default(0) @map("stock_sold")
  stockAdjusted Int      @default(0) @map("stock_adjusted")
  stockReturned Int      @default(0) @map("stock_returned")
  stock         Int      @default(0)
  reserved      Int      @default(0)
  threshold     Int      @default(15)
  status        String   @default("In Stock")
  batchNumber   String
  sellingPrice  Float
  mrp           Float
  updatedAt     DateTime @updatedAt

  @@index([sku])
  @@index([productId])
  @@index([batchNumber])
  @@map("inventory")
}

model InventoryTransaction {
  id          String          @id @default(uuid())
  sku         String
  batchNumber String?         @map("batch_number")
  type        InventoryTxType
  quantity    Int
  stockBefore Int             @map("stock_before")
  stockAfter  Int             @map("stock_after")
  referenceId String?         @map("reference_id")
  notes       String
  actorEmail  String          @map("actor_email")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([sku])
  @@index([referenceId])
  @@index([batchNumber])
  @@map("inventory_transactions")
}

model BatchEntity {
  id                  String   @id @default(uuid())
  batchNumber         String   @unique
  productId           String
  productName         String
  cropName            String?
  harvestDate         String?
  manufacturingDate   String?
  expiryDate          String?
  sourceRegion        String?
  farmerCluster       String?
  supplier            String?
  purchaseCost        Float?
  sellingPrice        Float?
  processingDate      String?
  millingDate         String?
  qualityPassed       Boolean  @default(true)
  packagingDate       String?
  bestBefore          String?
  moisturePercent     String?
  totalQuantityKg     Float    @default(0)
  remainingQuantityKg Float    @default(0)
  purityPercent       String?
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())

  @@index([batchNumber])
  @@index([productId])
}

// -----------------------------------------------------------------------------
// 3. Orders & Line Item Snapshots
// -----------------------------------------------------------------------------
model OrderEntity {
  id                      String         @id @default(uuid())
  orderNumber             String         @unique
  customerId              String?
  customer                User?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName            String
  email                   String
  mobile                  String
  shippingAddressSnapshot Json
  billingAddressSnapshot  Json
  subtotal                Float
  discount                Float          @default(0)
  shippingFee             Float          @default(0)
  tax                     Float          @default(0)
  total                   Float
  currency                String         @default("INR")
  paymentStatus           PaymentStatus  @default(CREATED)
  orderStatus             OrderStatus    @default(PENDING_PAYMENT)
  paymentMethod           String         @default("RAZORPAY")
  couponCode              String?
  paymentId               String?
  razorpayOrderId         String?
  razorpayPaymentId       String?
  shipmentId              String?
  courierPartner          String?
  trackingId              String?
  awbNumber               String?
  estimatedDelivery       String?
  timeline                Json           @default("[]")
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  items                   OrderItem[]
  payment                 PaymentEntity?

  @@index([orderNumber])
  @@index([email])
  @@index([mobile])
  @@index([orderStatus])
}

model OrderItem {
  id             String      @id @default(uuid())
  orderId        String
  order          OrderEntity @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  sku            String
  name           String
  localName      String
  selectedWeight String
  price          Float
  mrp            Float
  quantity       Int
  image          String
  batchNumber    String?

  @@index([orderId])
  @@index([sku])
}

// -----------------------------------------------------------------------------
// 4. Payments & Webhooks
// -----------------------------------------------------------------------------
model PaymentEntity {
  id                String        @id @default(uuid())
  orderId           String        @unique
  order             OrderEntity   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNumber       String
  amount            Int           // In paise
  currency          String        @default("INR")
  provider          String        @default("RAZORPAY")
  razorpayOrderId   String?
  razorpayPaymentId String?
  signature         String?
  status            PaymentStatus @default(CREATED)
  method            String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderNumber])
  @@index([razorpayOrderId])
}

model PaymentEvent {
  id                String   @id @default(uuid())
  paymentId         String?
  orderNumber       String
  eventType         String
  eventPayload      Json
  signatureVerified Boolean  @default(false)
  receivedAt        DateTime @default(now())

  @@index([orderNumber])
  @@index([eventType])
}

// -----------------------------------------------------------------------------
// 5. Coupons & Usage Records
// -----------------------------------------------------------------------------
model CouponEntity {
  code            String      @id
  type            CouponType  @default(PERCENTAGE)
  discountPercent Float?
  discountAmount  Float?
  minOrderValue   Float       @default(0)
  maxDiscount     Float?
  description     String
  expiryDate      String
  usageLimit      Int         @default(500)
  timesUsed       Int         @default(0)
  perUserLimit    Int         @default(1)
  isActive        Boolean     @default(true)
}

model CouponUsageRecord {
  id              String   @id @default(uuid())
  couponCode      String
  customerEmail   String
  orderNumber     String
  discountApplied Float
  usedAt          DateTime @default(now())

  @@index([couponCode])
  @@index([customerEmail])
}

// -----------------------------------------------------------------------------
// 6. Reviews & Returns
// -----------------------------------------------------------------------------
model ReviewEntity {
  id               String   @id @default(uuid())
  productId        String
  productName      String
  customerName     String
  customerEmail    String
  rating           Int
  comment          String
  verifiedPurchase Boolean  @default(false)
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())

  @@index([productId])
  @@index([customerEmail])
}

model ReturnRequestEntity {
  id           String   @id @default(uuid())
  orderNumber  String
  customerName String
  customerEmail String
  productName  String
  reason       String
  status       String   @default("REQUESTED")
  refundAmount Float
  refundMethod String
  requestedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderNumber])
  @@index([customerEmail])
}

// -----------------------------------------------------------------------------
// 7. Append-Only Audit Trail
// -----------------------------------------------------------------------------
model AuditLogEntity {
  id         String   @id @default(uuid())
  actorEmail String
  actorRole  String
  action     String
  entity     String
  entityId   String
  details    String
  timestamp  DateTime @default(now())

  @@index([entity])
  @@index([entityId])
  @@index([actorEmail])
}

// -----------------------------------------------------------------------------
// 8. Secure Cryptographic OTP Verification Records
// -----------------------------------------------------------------------------
model OtpVerification {
  id              String   @id @default(uuid())
  identifier      String   @unique
  hashedCode      String
  expiresAt       DateTime
  attempts        Int      @default(0)
  maxAttempts     Int      @default(5)
  lastRequestedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([identifier])
}

// -----------------------------------------------------------------------------
// 9. Customer Cart & Line Items
// -----------------------------------------------------------------------------
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  items     CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id             String   @id @default(uuid()) @db.Uuid
  cartId         String   @map("cart_id") @db.Uuid
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId      String   @map("product_id")
  selectedWeight String   @default("500g") @map("selected_weight")
  quantity       Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([cartId, productId, selectedWeight])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}


